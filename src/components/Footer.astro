---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { contact, footerLinks, tel } from '../data/site';
import { upload } from '../lib/images';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__grid" data-reveal="fade">
    <div>
      <a href="/" aria-label="iAM Capital home"><Image src={upload('2022/12/iAMCapital.png')} alt="" widths={[131, 262]} sizes="131px" class="footer__logo" /></a>
    </div>
    <div>
      <p>{contact.company}</p>
      <p>{contact.street}</p>
      <p>{contact.city}</p>
      <p>{contact.postcode}</p>
      <a class="footer__directions" href={contact.directions} target="_blank" rel="noopener">Get directions <Icon name="arrowRight" class="footer__arrow" /></a>
    </div>
    <div>
      <a class="footer__phone" href={tel(contact.phones[0])}>{contact.phones[0]}</a>
      <ul>
        <li><a href={`mailto:${contact.emails.general}`}>{contact.emails.general}</a></li>
        <li><a href={`mailto:${contact.emails.investors}`}>{contact.emails.investors}</a></li>
      </ul>
      <a class="footer__social" href={contact.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" class="footer__linkedin" label="iAM Capital on LinkedIn" /></a>
    </div>
    <nav aria-label="Legal">
      <ul>{footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
  <p class="footer__copy">© Copyright {year}, {contact.company}. All Rights Reserved</p>
</footer>

<style>
  .footer { background: var(--navy); color: var(--white); padding: 90px 0 35px; }
  .footer__grid {
    width: min(100% - 30px, 1140px); margin-inline: auto;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px;
  }
  .footer :global(.footer__logo) { width: 131px; height: auto; }
  .footer a:hover { opacity: 0.75; }
  .footer__directions { display: inline-flex; align-items: center; gap: 10px; margin-top: 10px; padding: 11px 0; line-height: 1; }
  .footer :global(.footer__arrow) { width: 16px; height: 16px; }
  .footer__phone { display: inline-block; margin-top: -5px; }
  .footer__social { display: inline-block; margin-top: 45px; }
  .footer :global(.footer__linkedin) { width: 26px; height: 26px; }
  .footer__copy { width: min(100% - 30px, 1170px); margin: 40px auto 0; font-size: 14px; line-height: 1.9; }
  @media (max-width: 991px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 575px) { .footer { padding-top: 50px; } .footer__grid { grid-template-columns: 1fr; } .footer__social { margin-top: 15px; } }
</style>
