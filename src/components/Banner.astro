---
// The photo banner that opens each inner page on the old site: 308px high, darkened, white title with a rule under it.
import { Image } from 'astro:assets';
import { upload } from '../lib/images';

interface Props {
  title: string;
  image: string;
  shade?: number;   // black overlay opacity, as set per page on the old site
  height?: number;
  tag?: 'h1' | 'h2';
  italic?: boolean;  // property pages set the name in bold italic
  rule?: number;     // width of the rule under the title
  position?: string;
}
const { title, image, shade = 0.2, height = 308, tag: Tag = 'h1', italic = false, rule = 117, position = 'center' } = Astro.props;
---
<section class="banner" style={`--h:${height}px;--shade:${shade}`}>
  <Image src={upload(image)} alt="" widths={[768, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="banner__img" style={`object-position:${position}`} />
  <div class="banner__shade"></div>
  <div class="container banner__text">
    <Tag class:list={['banner__title', { 'banner__title--italic': italic }]} style={`--rule:${rule}px`}>{title}</Tag>
  </div>
</section>

<style>
  .banner { position: relative; height: var(--h); display: flex; align-items: center; overflow: hidden; color: var(--white); }
  .banner :global(.banner__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .banner__shade { position: absolute; inset: 0; background: rgb(0 0 0 / var(--shade)); }
  .banner__text { position: relative; }
  .banner__title { font-size: 46px; line-height: 1.3; font-weight: 700; letter-spacing: -0.7px; }
  .banner__title--italic { font-size: 36px; font-style: italic; letter-spacing: -1.5px; }
  .banner__title::after { content: ''; display: block; width: var(--rule); height: 4px; background: currentColor; margin-top: 10px; }
  @media (max-width: 767px) {
    .banner { height: min(var(--h), 200px); }
    .banner__title { font-size: 36px; letter-spacing: -1px; }
    .banner__title--italic { font-size: 28px; }
  }
</style>
