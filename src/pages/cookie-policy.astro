---
// DRAFT, needs review by iAM Capital before launch. The old page was generated by the Complianz plugin from the
// WordPress setup, which no longer applies. This text describes what the new site actually does: no cookies of its
// own, cookieless Cloudflare Web Analytics, Google Maps on /investments/ and /contact/.
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import { contact } from '../data/site';
---
<Layout title="Cookie Policy" description="How the iAM Capital website uses cookies and similar technologies." noindex>
  <Banner title="Cookie Policy" image="2023/01/responsibility.jpg" shade={0.3} />
  <section class="section">
    <div class="container policy">
      <p class="draft">Draft for review. Last updated October 2026.</p>
      <h3>Cookies on this website</h3>
      <p>This website does not set cookies of its own. It does not use advertising cookies or cross-site tracking.</p>
      <h3>Analytics</h3>
      <p>We use Cloudflare Web Analytics to understand how many people visit the site and which pages they read. It does not use cookies and does not collect information that identifies you; visits are counted in aggregate.</p>
      <h3>Embedded content</h3>
      <p>The <a href="/investments/">Investments</a> and <a href="/contact/">Contact</a> pages show Google Maps. When these load, Google may set or read cookies and receive information such as your IP address, under its own privacy policy.</p>
      <h3>Documents and links</h3>
      <p>Reports and policies open as PDF files served from this website. Some news items link to articles on other websites, which have their own cookie policies.</p>
      <h3>Contact</h3>
      <p>For questions about this policy or how we handle personal data, see our <a href="/wp-content/uploads/2026/03/iAM-Capital-Privacy-Policy_v2-clean-v.pdf">Privacy Policy</a> or email <a href={`mailto:${contact.emails.general}`}>{contact.emails.general}</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .policy { max-width: 900px; margin-inline: auto; }
  .policy h3 { margin: 35px 0 10px; color: var(--navy); }
  .policy a { color: var(--navy); text-decoration: underline; }
  .draft { font-style: italic; color: var(--grey); }
</style>
