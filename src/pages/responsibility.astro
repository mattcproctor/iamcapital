---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import legal from '../data/legal.json';
import { upload } from '../lib/images';

const steps: { title: string; icon: IconName; text: string }[] = [
  { title: 'Screening', icon: 'faSearch', text: 'Confirm each opportunity is consistent with our criteria' },
  { title: 'Due Diligence', icon: 'faCheck', text: 'Complete ESG due diligence on every new investment' },
  { title: 'Planning', icon: 'faFile', text: 'Implement sustainability factors in each business plan' },
  { title: 'Monitoring', icon: 'faVideo', text: 'Actively monitor ESG performance with management teams' },
  { title: 'Exit', icon: 'faChart', text: 'Assess ESG performance and lessons learned after each divestment' },
];
---
<Layout
  title="Responsibility"
  description="iAM Capital considers ESG factors in its decision making and in all asset management activities. ESG principles and legal disclosures."
  image="2023/01/responsibility.jpg"
  subnav={[{ id: 'esg', label: 'ESG' }, { id: 'legal', label: 'Legal Disclosures' }]}
>
  <Banner title="Responsibility" image="2023/01/responsibility.jpg" shade={0} />

  <section class="intro">
    <div class="container">
      <p>iAM Capital considers ESG factors in its decision making and with regards to all asset management activities. The firm also strives to uphold the principles of responsible investing and attain globally recognized efficiency certifications.</p>
    </div>
  </section>

  <section id="esg" class="section">
    <div class="container">
      <h2 class="title title--wide">Environmental, Social &amp; Governance Principles</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <h5>{s.title}</h5>
            <span class="steps__icon"><Icon name={s.icon} class="steps__glyph" /></span>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="certs">
        <Image src={upload('2026/03/LEED-logo-scaled.png')} alt="LEED" widths={[200, 400]} sizes="200px" />
        <Image src={upload('2026/03/well-gold-solid-new.png')} alt="WELL Gold" widths={[200, 400]} sizes="200px" />
      </div>
    </div>
  </section>

  <section id="legal" class="section">
    <div class="container">
      <h2 class="title title--wide">Legal Disclosures</h2>
      <ul class="docs">
        {legal.map((d) => (
          <li>
            <Image src={upload('2023/01/file-pdf-icon.png')} alt="" widths={[38, 76]} sizes="38px" class="docs__icon" />
            <span class="docs__title">{d.title}</span>
            <a class="btn-navy" href={d.url} target="_blank" rel="noopener">View<span class="sr-only">: {d.title} (PDF, opens in a new tab)</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .intro { padding: 85px 0 10px; }
  .steps { display: grid; grid-template-columns: repeat(5, 200px); justify-content: center; gap: 30px; margin-top: 50px; text-align: center; }
  .steps h5::after { content: ''; display: block; width: 150px; height: 4px; background: rgb(0 0 0 / 0.75); margin: 7px auto 30px; }
  .steps__icon { display: grid; place-items: center; width: 56px; height: 56px; margin: 0 auto 30px; border-radius: 50%; background: var(--navy); color: var(--white); }
  .steps :global(.steps__glyph) { width: 24px; height: 24px; }
  .steps p { font-size: 15px; line-height: 1.9; }
  .certs { display: flex; justify-content: center; gap: 30px; margin-top: 40px; }
  .certs :global(img) { width: 200px; height: auto; }

  .docs { display: grid; gap: 10px; margin-top: 50px; }
  .docs li { display: grid; grid-template-columns: 60px 1fr auto; align-items: center; min-height: 56px; }
  .docs :global(.docs__icon) { width: 38px; height: 38px; margin-left: 11px; filter: grayscale(1) opacity(0.75); }
  .docs__title { padding-left: 10px; }
  .docs .btn-navy { width: 179px; padding-inline: 0; margin-right: 12px; }

  @media (max-width: 1199px) { .steps { grid-template-columns: repeat(5, 1fr); } }
  @media (max-width: 767px) {
    .intro { text-align: center; }
    .steps { grid-template-columns: 1fr 1fr; }
    .certs :global(img) { width: 130px; }
    .docs li { grid-template-columns: 50px 1fr; row-gap: 8px; }
    .docs .btn-navy { grid-column: 2; width: auto; justify-self: start; padding: 8px 30px; margin: 0; }
  }
</style>
