---
// The portfolio map (first built as iamcapital.vercel.app). Its markers and cards come from the property files iAM
// edits in Pages CMS (src/lib/properties.ts), built into the page as JSON for public/scripts/investments.js; this
// replaced the Google Sheet in October 2026. The map is MapLibre GL (bundled with the site) drawing OpenFreeMap's free
// vector tiles: no API key, no account, no cookies. The plain list below is for search engines and visitors without
// JavaScript.
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import '../styles/investments.css';
import { listed, location, status, pins, shortMonth } from '../lib/properties';
import { upload } from '../lib/images';

// One entry per pin, in the shape the map script has always read (the Sheet's columns), with a card-sized photo
const cardPhotos = new Map<string, string>();
for (const p of listed) {
  if (p.cardPhoto && !cardPhotos.has(p.cardPhoto)) {
    cardPhotos.set(p.cardPhoto, (await getImage({ src: upload(p.cardPhoto), width: 700, format: 'webp' })).src);
  }
}
const mapData = pins.map(({ property: p, status, category, size, acquired }) => ({
  name: p.name,
  city: p.city,
  country: p.country,
  category,
  status,
  sizeSqm: size ?? '',
  acquisitionDate: shortMonth(acquired),
  imageUrl: cardPhotos.get(p.cardPhoto) ?? '',
  portfolioUrl: `/${p.slug}/`,
  latitude: p.latitude,
  longitude: p.longitude,
}));

const active = listed.filter((p) => status(p) === 'Active');
const sold = listed.filter((p) => status(p) === 'Sold');
---
<Layout
  title="Investment Portfolio"
  pageType="CollectionPage"
  description="Explore iAM Capital's investment portfolio across Italy, France and Spain: residential, commercial and hospitality assets, active and sold."
  image="2026/03/CP1.jpg"
>
  <link slot="head" rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />

  <div class="investments-page">
    <h1 class="sr-only">iAM Capital Investment Portfolio</h1>

    <section class="map-section">
      <div class="map-section__container">
        <button id="filterToggle" class="filter-toggle" aria-label="Toggle filters">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
          Filters
        </button>
        <div id="filterPills" class="filter-pills"></div>
        <div id="map" class="map-section__map"></div>
        <div id="mapLoading" class="map-section__loading">
          <div class="loading-spinner"></div>
          <p>Loading investment properties...</p>
        </div>
        <div id="mapError" class="map-section__error" style="display: none;">
          <p>Unable to load property map. Please try again later.</p>
        </div>
      </div>
    </section>

    <section class="properties-section">
      <div class="properties-section__container">
        <h2 class="properties-section__title">Investment Portfolio</h2>
        <div class="category-filters" id="categoryFilters">
          <div class="category-filters__group">
            <span class="category-filters__label">Status:</span>
            <button class="category-filter-btn category-filter-btn--active" data-filter-type="status" data-filter-value="all">All</button>
            <button class="category-filter-btn" data-filter-type="status" data-filter-value="Active">Active</button>
            <button class="category-filter-btn" data-filter-type="status" data-filter-value="Sold">Sold</button>
          </div>
          <div class="category-filters__group">
            <span class="category-filters__label">Category:</span>
            <button class="category-filter-btn category-filter-btn--active" data-filter-type="category" data-filter-value="all">All</button>
          </div>
        </div>
        <div id="propertiesGrid" class="properties-grid"></div>
        <div id="propertiesLoading" class="properties-section__loading"><p>Loading property details...</p></div>
        <div id="propertiesError" class="properties-section__error" style="display: none;"><p>Unable to load property details.</p></div>

        <!-- Every property as plain HTML, linked to its page: what search and AI crawlers that don't run JavaScript
             read, and the list for visitors without it. Hidden once JavaScript runs, when the cards replace it. -->
        <div class="properties-noscript properties-static">
          <h3>Active Investments</h3>
          <ul>{active.map((p) => <li><a href={`/${p.slug}/`}><strong>{p.name}</strong></a> – {location(p)} – {p.category}</li>)}</ul>
          <h3>Sold Investments</h3>
          <ul>{sold.map((p) => <li><a href={`/${p.slug}/`}><strong>{p.name}</strong></a> – {location(p)} – {p.category}</li>)}</ul>
        </div>
      </div>
    </section>
  </div>

  <Fragment slot="scripts">
    <script type="application/json" id="map-data" set:html={JSON.stringify({ properties: mapData }).replace(/</g, '\\u003c')} />
    <script is:inline src="/scripts/investments.js"></script>
    <!-- After first paint: MapLibre loads (a separate file Astro bundles from node_modules), then initMap draws the
         map; the cards are drawn from the built-in data straight away -->
    <script>
      import 'maplibre-gl/dist/maplibre-gl.css';
      import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
      (window as any).afterFirstPaint(async () => {
        try {
          const maplibregl = await import('maplibre-gl');
          // MapLibre 6 runs its tile work in a separate file; ship it with the site and point MapLibre at it
          maplibregl.setWorkerUrl(workerUrl);
          (window as any).maplibregl = maplibregl;
          (window as any).initMap();
        } catch (error) {
          console.error('Map library failed to load:', error);
          (window as any).loadProperties();
          const loading = document.getElementById('mapLoading');
          const failed = document.getElementById('mapError');
          if (loading) loading.style.display = 'none';
          if (failed) failed.style.display = 'flex';
        }
      });
    </script>
  </Fragment>
</Layout>
