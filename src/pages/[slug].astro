---
// Property and event pages, at the same top-level addresses WordPress used (/castel-porrona/, /fintlv-investors-event/),
// laid out as the old property pages: photo banner with the name, text and fact table left, photo slider right, Back.
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Icon from '../components/Icon.astro';
import { upload } from '../lib/images';
import { properties, location, type Property } from '../lib/properties';
import events from '../data/events.json';

type Event = (typeof events)[number];

export const getStaticPaths = (() => [
  ...properties.map((p) => ({ params: { slug: p.slug }, props: { property: p, event: undefined } })),
  ...events.map((e) => ({ params: { slug: e.slug }, props: { property: undefined, event: e } })),
]) satisfies GetStaticPaths;

const { property: p, event: e } = Astro.props as { property?: Property; event?: Event };
const slides = p ? [...new Set(p.gallery.length ? p.gallery : [p.cover].filter(Boolean) as string[])] : (e?.images ?? []);
const bannerImage = p?.cover ?? slides[0] ?? '2023/01/pexels-john-smith-726484.jpg';
const title = p?.name ?? e!.title;
const description = p
  ? `${p.name}, ${location(p)}. ${(p.description[0] ?? '').replace(/<[^>]+>/g, '').slice(0, 140)}`
  : e!.headline || e!.title;
---
<Layout title={title} description={description} image={bannerImage}>
  <Banner title={title} image={bannerImage} shade={0.2} height={400} tag="h1" italic rule={75} />

  <section class="detail">
    <div class="detail__grid">
      <div class="detail__text">
        {p && p.description.map((d) => <p set:html={d} />)}
        {e && e.headline && <p><strong>{e.headline}</strong></p>}
        {e && e.captions.map((c) => <p>{c}</p>)}
        {p && (
          <table class="facts">
            <tbody>
              {p.facts.map((f) => <tr><th scope="row">{f.label}</th><td>{f.value}</td></tr>)}
            </tbody>
          </table>
        )}
        {e && e.videos.map((v) => (
          <div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${v}`} title={`${e.title} video`} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
        ))}
      </div>

      {slides.length > 0 && (
        <div class="slider" data-slider>
          <ul class="slider__track" aria-label={`${title} photos`}>
            {slides.map((s, i) => (
              <li><Image src={upload(s)} alt={`${title}, photo ${i + 1} of ${slides.length}`} widths={[565, 1130]} sizes="(min-width: 992px) 565px, 100vw" /></li>
            ))}
          </ul>
          {slides.length > 1 && (
            <>
              <button type="button" class="slider__btn slider__btn--prev" data-dir="-1" aria-label="Previous photo"><Icon name="arrowLeft" class="slider__arrow" /></button>
              <button type="button" class="slider__btn slider__btn--next" data-dir="1" aria-label="Next photo"><Icon name="arrowRight" class="slider__arrow" /></button>
              <div class="slider__dots">{slides.map((_, i) => <button type="button" data-dot={i} aria-label={`Photo ${i + 1}`}></button>)}</div>
            </>
          )}
        </div>
      )}
    </div>
    <a class="back" href={p ? '/investments/' : '/latest-news/#events'} data-back><Icon name="arrowLeft" class="back__icon" /> Back</a>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((s) => {
    const track = s.querySelector<HTMLElement>('.slider__track')!;
    const dots = [...s.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const count = track.children.length;
    let i = 0;
    const go = (n: number) => {
      i = (n + count) % count;
      track.style.transform = `translateX(${-100 * i}%)`;
      dots.forEach((d, k) => d.toggleAttribute('aria-current', k === i));
    };
    s.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) => b.addEventListener('click', () => go(i + Number(b.dataset.dir))));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    go(0);
  });
  // "Back" returns to the previous page when there is one on this site, as the old button did
  const back = document.querySelector<HTMLAnchorElement>('[data-back]');
  back?.addEventListener('click', (ev) => {
    if (document.referrer && new URL(document.referrer).origin === location.origin) { ev.preventDefault(); history.back(); }
  });
</script>

<style>
  .detail { width: min(100% - 30px, 1170px); margin-inline: auto; padding: 90px 0 60px; }
  .detail__grid { display: grid; grid-template-columns: 555px 1fr; gap: 30px; padding-inline: 15px; align-items: start; }
  .detail__text p + p { margin-top: 30px; }
  .detail__text :global(a) { text-decoration: underline; }
  .detail__text :global(a:hover) { color: var(--navy); }
  .facts { width: 100%; margin-top: 30px; border-collapse: collapse; font-family: var(--font-figures); line-height: 1.3; border: 1px solid #f1f1f1; }
  .facts th, .facts td { text-align: left; padding: 10px 21px; border-top: 1px solid #f1f1f1; vertical-align: top; }
  .facts th { font-weight: 700; color: var(--navy); text-transform: uppercase; width: 50%; }
  .video { aspect-ratio: 16 / 9; margin-top: 30px; }
  .video iframe { width: 100%; height: 100%; border: 0; }

  .slider { position: relative; overflow: hidden; }
  .slider__track { display: flex; transition: transform 0.6s ease; }
  .slider__track li { flex: 0 0 100%; }
  .slider__track :global(img) { width: 100%; aspect-ratio: 565 / 480; object-fit: cover; }
  .slider__btn { position: absolute; top: calc(50% - 30px); width: 28px; height: 28px; border-radius: 50%; border: 0; background: rgb(0 0 0 / 0.75); color: var(--white); display: grid; place-items: center; cursor: pointer; }
  .slider__btn--prev { left: 15px; }
  .slider__btn--next { right: 15px; }
  .slider :global(.slider__arrow) { width: 16px; height: 16px; stroke-width: 2.5; }
  .slider__dots { display: flex; justify-content: center; gap: 8px; padding: 15px 0 5px; }
  .slider__dots button { width: 10px; height: 10px; border-radius: 50%; border: 0; padding: 0; background: #8a8a8a; cursor: pointer; }
  .slider__dots button[aria-current] { background: #222; }

  .back { display: inline-flex; align-items: center; gap: 10px; color: var(--navy); margin-top: 40px; padding: 14px 0; }
  .detail :global(.back__icon) { width: 16px; height: 16px; }

  @media (max-width: 991px) { .detail__grid { grid-template-columns: 1fr; padding-inline: 0; } .detail { padding-top: 50px; } }
</style>
