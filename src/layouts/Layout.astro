---
// The page shell every page shares: the head (meta, social tags, fonts, structured data),
// the header and the footer. Pages pass their title, description and, optionally, a social image and whether the
// header sits over a full-bleed photo. Extra head tags go in the "head" slot and page scripts in the "scripts" slot.
import '@fontsource/overpass/400-italic.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/source-sans-3/300.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/700.css';
import fontFaces from '../styles/overpass.css?raw';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { upload } from '../lib/images';
import { clip, organization, website, SITE } from '../lib/seo';

interface Props {
  title: string;
  seoTitle?: string; // the full <title>, when it should differ from "Title - iAM Capital"
  description: string;
  crumbs?: { name: string; path: string }[]; // breadcrumb trail after Home, for structured data
  pageType?: string; // schema.org WebPage type: AboutPage, ContactPage, CollectionPage ...
  extraLd?: Record<string, unknown>[]; // more structured data for this page (people, places ...)
  image?: string; // a path in src/assets/uploads
  overlay?: boolean;
  subnav?: { id: string; label: string }[];
  noindex?: boolean;
}

const {
  title, seoTitle, image = '2023/01/pexels-john-smith-726484.jpg', overlay = false, subnav = [], noindex = false,
  pageType = 'WebPage', extraLd = [],
} = Astro.props;
const description = clip(Astro.props.description);
const fullTitle = seoTitle ?? (title === 'iAM Capital' ? 'iAM Capital | A Global Alternative Investment Group' : `${title} - iAM Capital`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
const crumbs = Astro.props.crumbs ?? (isHome ? [] : [{ name: title, path: Astro.url.pathname }]);
const social = await getImage({ src: upload(image), width: 1200, format: 'jpg' });
const socialUrl = new URL(social.src, Astro.site);

// One JSON-LD graph per page: the company, the website, this page, its breadcrumb trail and anything page-specific
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    website,
    {
      '@type': pageType,
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: fullTitle,
      description,
      inLanguage: 'en-GB',
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#organization` },
      primaryImageOfPage: socialUrl.href,
      ...(crumbs.length ? { breadcrumb: { '@id': `${canonical.href}#breadcrumb` } } : {}),
    },
    ...(crumbs.length
      ? [{
          '@type': 'BreadcrumbList',
          '@id': `${canonical.href}#breadcrumb`,
          itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
            '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, SITE).href,
          })),
        }]
      : []),
    ...extraLd,
  ],
};
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow" />}
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#19375f" />
  <!-- Google Search Console ownership of iamcapital.com, carried over from the old site (Yoast) -->
  <meta name="google-site-verification" content="Ne6vE6PAIIUyx3_sdoBi4PwNLsE4ZfWapL5u_JZZP5c" />

  <link rel="icon" type="image/png" sizes="32x32" href="/images/branding/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/images/branding/favicon-192x192.png" />
  <link rel="apple-touch-icon" href="/images/branding/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="iAM Capital" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialUrl} />

  <link rel="preload" href="/fonts/overpass/qFdH35WCmI96Ajtm81GlU9vgwBcI.woff2" as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={fontFaces}></style>

  <script is:inline>
    document.documentElement.classList.add('js');
    // afterFirstPaint(fn): runs fn once the page has painted (the investments page loads Google Maps then)
    window.afterFirstPaint = function (fn) {
      var done = false;
      function run() { if (!done) { done = true; setTimeout(fn, 0); } }
      try {
        new PerformanceObserver(function (list) {
          if (list.getEntriesByName('first-contentful-paint').length) run();
        }).observe({ type: 'paint', buffered: true });
      } catch (e) { addEventListener('load', run); }
      setTimeout(run, 3000);
    };
  </script>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />

  <!-- Analytics: turn on Cloudflare Web Analytics for the Pages project in the Cloudflare dashboard, which adds its
       cookieless beacon to every page; nothing is needed here. -->
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header overlay={overlay} subnav={subnav} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <slot name="scripts" />
  <script>
    // Scroll-in motion (see global.css): mark each data-reveal element once it comes into view
    const reveal = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      reveal.forEach((el) => io.observe(el));
    } else reveal.forEach((el) => el.classList.add('is-in'));
  </script>
</body>
</html>
