---
// The page shell every page shares: the head (meta, social tags, fonts, styles, structured data, Vercel Web Analytics),
// the header and the footer. Pages pass their own title, description and address, and their scripts in the
// "scripts" slot, which comes after the footer.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Fonts and styles go inline, so the first paint waits for no stylesheet request. Overpass is self-hosted with
// Google Fonts' own @font-face rules and files (src/styles/overpass.css); public/investments.css stays served as it was.
import fontFaces from '../styles/overpass.css?raw';
import styles from '../../public/investments.css?raw';

interface Props {
  title: string;
  socialTitle: string;
  description: string;
  url: string;
}

const { title, socialTitle, description, url } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow">
    <link rel="canonical" href={url} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="images/branding/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="images/branding/favicon-192x192.png">
    <link rel="apple-touch-icon" href="images/branding/apple-touch-icon.png">

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website">
    <meta property="og:title" content={socialTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={url}>
    <meta property="og:image" content="https://iamcapital.vercel.app/images/branding/favicon-192x192.png">
    <meta property="og:site_name" content="iAM Capital">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={socialTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://iamcapital.vercel.app/images/branding/favicon-192x192.png">

    <!-- Preload critical assets (the Latin font at low priority: text paints in the fallback first, as before) -->
    <link rel="preconnect" href="https://maps.googleapis.com">
    <link rel="preconnect" href="https://maps.gstatic.com" crossorigin>
    <link rel="preload" href="/fonts/overpass/qFdH35WCmI96Ajtm81GlU9vgwBcI.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low">

    <!-- Stylesheets -->
    <style is:inline set:html={fontFaces}></style>
    <style is:inline set:html={styles}></style>

    <!-- afterFirstPaint(fn): runs fn once the page has painted (the Google Map and its data load then, behind the
         loading overlay that covers the map until the properties arrive) -->
    <script is:inline>
        window.afterFirstPaint = function (fn) {
            var done = false;
            function run() { if (!done) { done = true; setTimeout(fn, 0); } }
            try {
                new PerformanceObserver(function (list) {
                    if (list.getEntriesByName('first-contentful-paint').length) run();
                }).observe({ type: 'paint', buffered: true });
            } catch (e) { addEventListener('load', run); }
            setTimeout(run, 3000);
        };
    </script>

    <!-- Structured Data -->
    <script is:inline type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "iAM Capital Group Ltd",
        "url": "https://iamcapital.com",
        "logo": "https://iamcapital.vercel.app/images/branding/iam-capital-logo.webp",
        "description": "A global alternative investment group with a portfolio spanning residential, commercial, hospitality, and renewable energy sectors across Europe.",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "4 Hill Street",
            "addressLocality": "London",
            "postalCode": "W1J 5NE",
            "addressCountry": "GB"
        },
        "telephone": "+442075149200",
        "email": "info@iamcapital.com",
        "sameAs": [
            "https://www.linkedin.com/company/iam-capital/"
        ]
    }
    </script>

    <!-- Vercel Web Analytics -->
    <script is:inline>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body>
    <!-- Header/Navigation -->
    <Header />
    <main>
    <slot />
    </main>
    <!-- Footer -->
    <!-- Footer -->
    <Footer />
    <slot name="scripts" />
</body>
</html>
